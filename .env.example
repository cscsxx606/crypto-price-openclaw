# Crypto Price Skill - 邮箱配置模板
# 复制此文件为 .env 并填入实际值
# 注意：.env 文件不应提交到 Git！

# 发件人邮箱（126 邮箱）
EMAIL_SENDER=your_email@126.com

# 发件人名称（显示在邮件中）
EMAIL_SENDER_NAME=OpenClaw Crypto Report

# SMTP 授权码（不是登录密码！）
# 获取方式：登录 126 邮箱 -> 设置 -> POP3/SMTP/IMAP -> 开启 SMTP -> 获取授权码
EMAIL_PASSWORD=your_smtp_password

# 收件人邮箱（接收周报的邮箱）
EMAIL_RECIPIENT=recipient@example.com

# 可选：要监控的币种（逗号分隔）
# DEFAULT_COINS=BTC,ETH,BNB,SOL,DOGE

# 可选：历史数据天数
# DAYS=7
